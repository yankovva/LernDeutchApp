@using LerningApp.Web.ViewModels.UsersCouses
@model UsersCoursesIndexViewModel

@{
    ViewData["Title"] = "My Courses";
}

<section class="brand-page brand-page--my-courses">
    <div class="brand-hero brand-hero--compact">
        <div class="brand-hero__content">
            <span class="brand-badge">My learning space</span>
            <h1>Your courses, progress, and next steps in one place.</h1>
            <p class="brand-lead">
                Keep track of the courses you have started, continue learning where you left off,
                and build a stronger rhythm with every return to the platform.
            </p>
        </div>

        <div class="dashboard-note">
            <span class="dashboard-note__label">Focus</span>
            <strong>Consistency beats intensity.</strong>
            <p>Even small learning sessions count when your path stays clear and accessible.</p>
        </div>
    </div>

    @if (!Model.Courses.Any())
    {
        <div class="brand-empty">
            <h2>You are not enrolled in any courses yet</h2>
            <p>Browse the catalog, pick a course that fits your level, and start building momentum.</p>
            <div class="brand-actions">
                <a asp-controller="Course" asp-action="Index" class="brand-button brand-button--primary">
                    Explore courses
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="dashboard-grid">
            @foreach (var c in Model.Courses)
            {
                <article class="dashboard-card">
                    <div class="dashboard-card__cover">
                        <img src="/images/Common/default-course-img.png" alt="@c.Name" class="dashboard-card__image" />
                        <span class="catalog-badge catalog-badge--level">@c.LevelName</span>
                    </div>

                    <div class="dashboard-card__body">
                        <h3>@c.Name</h3>
                        <p>@c.Description</p>

                        <div class="dashboard-meta">
                            <div>
                                <small>Started</small>
                                <strong>@c.StartedAt.ToString("dd.MM.yyyy")</strong>
                            </div>
                            <div>
                                <small>Status</small>
                                <strong>@(c.CompletedAt.HasValue ? "Completed" : "In progress")</strong>
                            </div>
                            @if (c.CompletedAt.HasValue)
                            {
                                <div>
                                    <small>Completed</small>
                                    <strong>@c.CompletedAt.Value.ToString("dd.MM.yyyy")</strong>
                                </div>
                            }
                        </div>

                        <a asp-controller="Course" asp-action="Details" asp-route-id="@c.Id" class="brand-button brand-button--secondary brand-button--block">
                            Open course
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</section>
