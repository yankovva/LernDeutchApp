@using LerningApp.Web.ViewModels.MultipleChoiceExercise
@using static LerningApp.Common.Enums
@model EditMultipleExerciseViewModel

@{
    ViewData["Title"] = "Edit Multiple Choice Exercise";
    var difficultyOptions = Enum.GetValues<ExerciseDifficultyLevel>()
        .Select(x => new
        {
            Value = (int)x,
            Text = x.ToString()
        })
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted">Редактирай multiple-choice упражнение.</div>
    <a asp-area="Teacher"
       asp-controller="Lesson"
       asp-action="Index"
       class="btn btn-outline-secondary">
        ← Назад
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Question" class="form-label">Въпрос</label>
                        <input asp-for="Question"
                               class="form-control"
                               placeholder="Пример: Какво означава Haus?" />
                        <span asp-validation-for="Question" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DifficultyLevel" class="form-label">Трудност</label>
                        <select asp-for="DifficultyLevel" class="form-select">
                            @foreach (var option in difficultyOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                        <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                    </div>

                    <h5 class="mb-3">Отговори</h5>

                    @for (int i = 0; i < Model.Options.Count; i++)
                    {
                        <div class="row mb-3 align-items-center">
                            <div class="col-md-8">
                                <label class="form-label">Опция @(i + 1)</label>
                                <input asp-for="Options[i].AnswerText"
                                       class="form-control"
                                       placeholder="Въведи отговор" />
                                <span asp-validation-for="Options[i].AnswerText" class="text-danger"></span>

                                <input asp-for="Options[i].OrderIndex" type="hidden" />
                                <input asp-for="Options[i].IsCorrect" type="hidden" class="is-correct-hidden" />
                            </div>

                            <div class="col-md-4 pt-md-4">
                                <div class="form-check">
                                    <input type="radio"
                                           class="form-check-input"
                                           name="correctOption"
                                           value="@i"
                                           @(Model.Options[i].IsCorrect ? "checked" : null)
                                           onchange="setCorrect(@i)" />
                                    <label class="form-check-label">Correct</label>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">💾 Запази</button>
                        <a asp-area="Teacher"
                           asp-controller="Lesson"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Отказ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setCorrect(optionIndex) {
            const hiddenInputs = document.querySelectorAll('.is-correct-hidden');
            hiddenInputs.forEach(x => x.value = 'false');

            const target = document.querySelector(`input[name="Options[${optionIndex}].IsCorrect"]`);
            if (target) {
                target.value = 'true';
            }
        }
    </script>
}
