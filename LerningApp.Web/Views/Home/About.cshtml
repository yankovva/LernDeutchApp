@{
    ViewData["Title"] = "About";
}

<section class="brand-page brand-page--about">
    <div class="brand-hero brand-hero--split">
        <div class="brand-hero__content">
            <span class="brand-badge">About DeutschBuddy</span>
            <h1>Learning German should feel inspiring, clear, and human.</h1>
            <p class="brand-lead">
                DeutschBuddy is built to make language learning feel less overwhelming and more
                structured. We combine clear lesson paths, warm design, and practical exercises so
                students can keep moving forward with confidence.
            </p>

            <div class="brand-pill-row">
                <span class="brand-pill">A1 to B2 progression</span>
                <span class="brand-pill">Structured lessons</span>
                <span class="brand-pill">Steady learner momentum</span>
            </div>
        </div>

        <div class="brand-hero__panel">
            <div class="brand-glow-card">
                <span class="brand-glow-card__label">Our mission</span>
                <h3>Make language progress feel visible every day.</h3>
                <p>
                    A calm interface, thoughtful content structure, and motivating practice flow
                    all work together to support real consistency.
                </p>
            </div>
            <div class="brand-floating brand-floating--one">Clarity first</div>
            <div class="brand-floating brand-floating--two">Practice with purpose</div>
        </div>
    </div>

    <section class="brand-section">
        <div class="brand-section__intro">
            <span class="brand-section__eyebrow">How it works</span>
            <h2>A simple path from first steps to lasting confidence</h2>
            <p>
                The platform is designed to reduce friction. Students know what to do next, where
                to continue, and how each lesson connects to the bigger picture.
            </p>
        </div>

        <div class="brand-steps">
            <article class="brand-step-card">
                <span class="brand-step-card__number">01</span>
                <h3>Choose your level</h3>
                <p>
                    Start at the stage that fits you best and move through material in a natural order.
                </p>
            </article>

            <article class="brand-step-card">
                <span class="brand-step-card__number">02</span>
                <h3>Learn in small steps</h3>
                <p>
                    Lessons are structured to feel digestible, so progress stays sustainable and focused.
                </p>
            </article>

            <article class="brand-step-card">
                <span class="brand-step-card__number">03</span>
                <h3>Reinforce through practice</h3>
                <p>
                    Exercises, repetition, and guided learning patterns help knowledge stay with you.
                </p>
            </article>
        </div>
    </section>

    <section class="brand-section brand-section--soft">
        <div class="brand-split-grid">
            <div>
                <span class="brand-section__eyebrow">What makes it different</span>
                <h2>Designed for students who need both structure and warmth</h2>
                <p class="brand-copy">
                    Many learning tools are either too dry or too chaotic. DeutschBuddy aims for a
                    better middle ground: approachable visuals, focused course organization, and a
                    study rhythm that encourages learners to return.
                </p>
            </div>

            <div class="brand-info-grid">
                <article class="brand-info-card">
                    <h3>Clear content flow</h3>
                    <p>Every section supports the next one, so the learning journey feels connected.</p>
                </article>

                <article class="brand-info-card">
                    <h3>Friendly experience</h3>
                    <p>The interface feels warm and modern instead of cold, cluttered, or intimidating.</p>
                </article>

                <article class="brand-info-card">
                    <h3>Built for momentum</h3>
                    <p>Students can keep going without losing track of where they are or what comes next.</p>
                </article>

                <article class="brand-info-card">
                    <h3>Practical learning</h3>
                    <p>Lessons and exercises are shaped around useful progress, not just theory on a page.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="brand-cta-panel">
        <div>
            <span class="brand-section__eyebrow">Start exploring</span>
            <h2>See the courses and begin your next step in German.</h2>
            <p>
                Browse the course catalog, find the right level, and start learning in a way that
                feels more organized and motivating.
            </p>
        </div>

        <div class="brand-actions">
            <a asp-controller="Course" asp-action="Index" class="brand-button brand-button--primary">
                Explore courses
            </a>
            <a asp-controller="Home" asp-action="Contact" class="brand-button brand-button--secondary">
                Contact us
            </a>
        </div>
    </section>
</section>
