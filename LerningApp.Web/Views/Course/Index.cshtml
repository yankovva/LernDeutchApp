@using LerningApp.Services.Data.Interfaces
@using LerningApp.Web.Infrastructure.Extensions
@using LerningApp.Web.ViewModels.Course
@inject ITeacherService teacherService
@model IEnumerable<CourseIndexViewModel>

@{
    ViewData["Title"] = "Courses";
}

<section class="brand-page brand-page--courses">
    <div class="brand-hero brand-hero--courses">
        <div class="brand-hero__content">
            <span class="brand-badge">Course catalog</span>
            <h1>Choose the course that matches your next German goal.</h1>
            <p class="brand-lead">
                Explore structured courses that guide learners through practical, manageable steps.
                Each course is designed to turn progress into something visible and motivating.
            </p>

            <div class="brand-actions">
                <a href="#course-grid" class="brand-button brand-button--primary">
                    Browse courses
                </a>
                @if (User.Identity?.IsAuthenticated == true && await teacherService.IsUserTeacherAsync(User.GetUserId()!))
                {
                    <a asp-action="Create" class="brand-button brand-button--secondary">
                        Create course
                    </a>
                }
            </div>
        </div>

        <div class="catalog-highlight">
            <div class="catalog-highlight__card">
                <span class="catalog-highlight__label">Learning path</span>
                <strong>Curated, calm, and consistent</strong>
                <p>Find the right level, follow the lessons, and build momentum with less friction.</p>
            </div>
            <div class="catalog-highlight__pill catalog-highlight__pill--one">Bright orange energy</div>
            <div class="catalog-highlight__pill catalog-highlight__pill--two">Smart course structure</div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="brand-empty">
            <h2>No courses yet</h2>
            <p>The catalog is still empty. New learning paths will appear here once courses are added.</p>
        </div>
    }
    else
    {
        <div id="course-grid" class="catalog-grid">
            @foreach (var course in Model)
            {
                <article class="catalog-card @(course.IsActive == false ? "catalog-card--inactive" : string.Empty)">
                    <div class="catalog-card__glow"></div>

                    <div class="catalog-card__top">
                        <span class="catalog-badge catalog-badge--level">@course.CourseLevel</span>
                        @if (course.IsEnrolled)
                        {
                            <span class="catalog-badge catalog-badge--success">Enrolled</span>
                        }
                        @if (course.IsActive == false)
                        {
                            <span class="catalog-badge catalog-badge--muted">Inactive</span>
                        }
                    </div>

                    <h3>@course.Name</h3>

                    <div class="catalog-metrics">
                        <span>@course.LessonsCount lessons</span>
                        <span>@course.EnrolledCount students</span>
                    </div>

                    <div class="catalog-price-row">
                        <div>
                            <small>Format</small>
                            <strong>Online learning</strong>
                        </div>
                        <div class="catalog-price">
                            <small>Price</small>
                            <strong>@course.Price €</strong>
                        </div>
                    </div>

                    <div class="catalog-card__actions">
                        <a asp-action="Details" asp-route-id="@course.Id" class="brand-button brand-button--primary brand-button--block">
                            View course
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</section>
