@model LerningApp.Web.ViewModels.ListeningExercise.EditListeningQuestionInputModel

<form asp-area="Teacher"
      asp-controller="ListeningExercise"
      asp-action="EditQuestion"
      method="post"
      id="editListeningQuestionForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <input asp-for="Id" type="hidden" />
    <input asp-for="ExerciseId" type="hidden" />

    <div class="mb-4">
        <label asp-for="QuestionText" class="form-label fw-semibold">Question Text</label>
        <input asp-for="QuestionText" class="form-control" placeholder="Enter the question" />
        <span asp-validation-for="QuestionText" class="text-danger"></span>
    </div>

    <h6 class="mb-3">Answer Options</h6>

    <div class="row g-3">
        @for (int i = 0; i < Model.Options.Count; i++)
        {
            <div class="col-md-6">
                <form asp-area="Teacher"
                      asp-controller="ListeningExercise"
                      asp-action="DeleteOption"
                      method="post"
                      class="d-inline"
                    @Html.AntiForgeryToken()>
                    <input type="hidden" name="optionId" value="@Model.Options[i]" />
                    <input type="hidden" name="questionId" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <i class="fa-solid fa-circle-minus" style="color: rgb(255, 63, 0);"></i>
                    </button>
                </form>
                <div class="border rounded p-3 bg-light h-100">
                    <label asp-for="Options[i].AnswerText" class="form-label">
                        Option @(i + 1)
                    </label>

                    <input asp-for="Options[i].AnswerText"
                           class="form-control mb-2"
                           placeholder="Enter answer option"/>
                    <span asp-validation-for="Options[i].AnswerText" class="text-danger"></span>

                    <input asp-for="Options[i].Id" type="hidden"/>
                    <input asp-for="Options[i].OrderIndex" type="hidden"/>

                    <div class="form-check mt-2">
                        <input type="radio"
                               class="form-check-input"
                               asp-for="CorrectOptionIndex"
                               value="@i"
                               checked="@(Model.CorrectOptionIndex == i)"/>
                        <label class="form-check-label">Correct Answer</label>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between mt-4">
        <form asp-area="Teacher"
              asp-controller="ListeningExercise"
              asp-action="DeleteQuestion"
              method="post"
              class="d-inline"
              onsubmit="return confirm('Are you sure you want to delete this question?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="questionId" value="@Model.Id" />
            <input type="hidden" name="exerciseId" value="@Model.ExerciseId" />
            <button type="submit" class="btn btn-outline-danger">
                Delete
            </button>
        </form>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                Cancel
            </button>
            <button type="submit" class="btn btn-primary">
                Save 
            </button>
        </div>
    </div>
</form>

<partial name="_ValidationScriptsPartial" />
