@model LerningApp.Web.ViewModels.ListeningExercise.EditListeningQuestionInputModel

<form asp-area="Teacher"
      asp-controller="ListeningExercise"
      asp-action="EditQuestion"
      method="post"
      id="editListeningQuestionForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <input asp-for="Id" type="hidden" />
    <input asp-for="ExerciseId" type="hidden" />

    <div class="mb-4">
        <label asp-for="QuestionText" class="form-label fw-semibold fs-5">Question Text</label>
        <input asp-for="QuestionText" class="form-control" placeholder="Enter the question" />
        <span asp-validation-for="QuestionText" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0 fs-4">Answer Options</h6>

        <button type="button" class="btn btn-sm btn-outline-success add-option-btn">
            <i class="fa-solid fa-plus"></i>
            Add Option
        </button>
    </div>

    <div class="row g-3 question-options-container">
    @for (int i = 0; i < Model.Options.Count; i++)
        {
            <div class="col-md-6 option-item">
            <div class="border rounded p-3 bg-light h-100 d-flex flex-column">
                    <label asp-for="Options[i].AnswerText" class="form-label fw-semibold">
                        Option @(i + 1)
                    </label>

                    <input asp-for="Options[i].AnswerText"
                           class="form-control mb-2"
                           placeholder="Enter answer option"/>
                    <span asp-validation-for="Options[i].AnswerText" class="text-danger"></span>

                    <input asp-for="Options[i].Id" type="hidden"/>
                    <input asp-for="Options[i].OrderIndex" type="hidden"/>

                    <div class="form-check mt-2">
                        <input type="radio"
                               class="form-check-input"
                               asp-for="CorrectOptionIndex"
                               value="@i"
                               checked="@(Model.CorrectOptionIndex == i)"/>
                        <label class="form-check-label">Correct Answer</label>
                    </div>

                    <div class="mt-auto pt-3">
                        <button type="button"
                                class="btn btn-sm btn-outline-danger delete-option-btn"
                                data-option-id="@Model.Options[i].Id"
                                data-question-id="@Model.Id">
                            <i class="fa-solid fa-circle-minus"></i>
                            Remove Option
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-between mt-4">
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary cancel-question-editor-btn">
                Cancel
            </button>
            <button type="submit" class="btn btn-primary">
                Save
            </button>
        </div>
    </div>
</form>

<partial name="_ValidationScriptsPartial" />
