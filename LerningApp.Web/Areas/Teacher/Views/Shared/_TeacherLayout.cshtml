@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Teacher Panel";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - Teacher Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
          integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
    <style>
        :root {
            --teacher-bg: #f3f6fb;
            --teacher-surface: #ffffff;
            --teacher-sidebar: #102542;
            --teacher-sidebar-alt: #1b3358;
            --teacher-border: #d9e3ef;
            --teacher-text: #102542;
            --teacher-muted: #64748b;
            --teacher-accent: #0f766e;
            --teacher-accent-hover: #115e59;
            --teacher-light-btn: #e2e8f0;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            background: var(--teacher-bg);
            color: var(--teacher-text);
            font-family: "Segoe UI", sans-serif;
        }

        .teacher-shell {
            display: grid;
            grid-template-columns: 96px 1fr;
            min-height: 100vh;
        }

        .teacher-sidebar {
            background: linear-gradient(180deg, var(--teacher-sidebar), var(--teacher-sidebar-alt));
            color: white;
            padding: 1.4rem 0.9rem;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255,255,255,0.08);
        }

        .teacher-brand {
            font-size: 1.6rem;
            font-weight: 800;
            letter-spacing: 0.03em;
            margin-bottom: 1.8rem;
            text-align: center;
        }

        .teacher-brand span {
            display: none;
        }

        .teacher-nav-title {
            display: none;
        }

        .teacher-nav {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            align-items: center;
        }

        .teacher-nav a {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: rgba(255,255,255,0.92);
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            font-weight: 600;
            transition: background 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
        }

        .teacher-nav a:hover {
            background: rgba(255,255,255,0.11);
            color: white;
            transform: translateY(-1px);
            border-color: rgba(255,255,255,0.16);
        }

        .teacher-nav-icon {
            font-size: 1.35rem;
            line-height: 1;
        }

        .teacher-nav-label {
            position: absolute;
            left: calc(100% + 12px);
            top: 50%;
            transform: translateY(-50%);
            white-space: nowrap;
            padding: 0.55rem 0.8rem;
            border-radius: 12px;
            background: #ffffff;
            color: var(--teacher-text);
            font-size: 0.85rem;
            font-weight: 700;
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.18);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.16s ease, transform 0.16s ease;
            z-index: 20;
        }

        .teacher-nav a:hover .teacher-nav-label {
            opacity: 1;
            transform: translateY(-50%) translateX(2px);
        }

        .teacher-sidebar-footer {
            margin-top: auto;
            padding-top: 1rem;
            text-align: center;
            font-size: 1.25rem;
            color: rgba(255,255,255,0.55);
        }

        .teacher-main {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .teacher-topbar {
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--teacher-border);
            padding: 1.2rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .teacher-topbar-title h1 {
            margin: 0;
            font-size: 1.55rem;
            font-weight: 800;
        }

        .teacher-topbar-title p {
            margin: 0.3rem 0 0;
            color: var(--teacher-muted);
            font-size: 0.95rem;
        }

        .teacher-topbar-actions {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .teacher-topbar-actions a {
            text-decoration: none;
            border-radius: 12px;
            padding: 0.7rem 1rem;
            font-weight: 700;
            font-size: 0.92rem;
        }

        .teacher-btn-main {
            background: var(--teacher-accent);
            color: white;
        }

        .teacher-btn-main:hover {
            background: var(--teacher-accent-hover);
            color: white;
        }

        .teacher-btn-light {
            background: var(--teacher-light-btn);
            color: var(--teacher-text);
            border: 1px solid var(--teacher-border);
        }

        .teacher-btn-light:hover {
            background: #cbd5e1;
            color: var(--teacher-text);
        }

        .teacher-content {
            padding: 2rem;
        }

        .teacher-page-card {
            background: var(--teacher-surface);
            border: 1px solid var(--teacher-border);
            border-radius: 20px;
            box-shadow: 0 14px 35px rgba(15, 23, 42, 0.05);
            padding: 1.5rem;
        }

        @@media (max-width: 900px) {
            .teacher-shell {
                grid-template-columns: 1fr;
            }

            .teacher-sidebar {
                border-right: none;
                border-bottom: 1px solid rgba(255,255,255,0.08);
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 1rem;
            }

            .teacher-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-start;
            }

            .teacher-topbar {
                padding: 1rem 1.25rem;
                flex-direction: column;
                align-items: flex-start;
            }

            .teacher-content {
                padding: 1.25rem;
            }
        }
    </style>
</head>
<body>
<div class="teacher-shell">
    <aside class="teacher-sidebar">
        <div class="teacher-brand">
            <i class="fa-solid fa-graduation-cap " style="color: rgb(237, 237, 237);"></i>
        </div>

        <nav class="teacher-nav">
            <a asp-area="Teacher" asp-controller="Home" asp-action="Index" title="Dashboard">
                <i class="fa-solid fa-house-user" style="color: rgb(237, 237, 237);"></i>
                <span class="teacher-nav-label">Dashboard</span>
            </a>
            @if (User.IsInRole("Teacher"))
            {
                <a asp-area="" asp-controller="Profile" asp-action="TeacherIndex" title="Teacher Profile">
                    <i class="fa-regular fa-user "  style="color: rgb(237, 237, 237);"></i>
                    <span class="teacher-nav-label">Teacher Profile</span>
                </a>
            }
            <a asp-area="Teacher" asp-controller="Course" asp-action="Index" title="Courses">
                <i class="fa-solid fa-book" style="color: rgb(237, 237, 237);"></i>
                <span class="teacher-nav-label">Courses</span>
            </a>
            <a asp-area="Teacher" asp-controller="Lesson" asp-action="Index" title="Lessons">
                <i class="fa-solid fa-file-pen "  style="color: rgb(237, 237, 237);"></i>
                <span class="teacher-nav-label">Lessons</span>
            </a>
            <a asp-area="" asp-controller="Home" asp-action="Index" title="Main Site">
                <i class="fa-solid fa-earth-americas"  style="color: rgb(237, 237, 237);"></i>
                <span class="teacher-nav-label">Main Site</span>
            </a>
        </nav>

        <div class="teacher-sidebar-footer">
            ✦
        </div>
    </aside>

    <main class="teacher-main">
        <header class="teacher-topbar">
            <div class="teacher-topbar-title">
                <h1>@pageTitle</h1>
                <p>Manage your teacher profile, lessons, courses, and educational materials.</p>
            </div>

            <div class="teacher-topbar-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="teacher-btn-light">Main Site</a>
                <a asp-area="Teacher" asp-controller="Home" asp-action="Index" class="teacher-btn-main">Dashboard</a>
            </div>
        </header>

        <section class="teacher-content">
            <div class="teacher-page-card">
                @RenderBody()
            </div>
        </section>
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
