@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Teacher Panel";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - Teacher Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"/>
    <style>
        :root {
            --teacher-bg: #f3f6fb;
            --teacher-surface: #ffffff;
            --teacher-sidebar: #102542;
            --teacher-sidebar-alt: #1b3358;
            --teacher-border: #d9e3ef;
            --teacher-text: #102542;
            --teacher-muted: #64748b;
            --teacher-accent: #0f766e;
            --teacher-accent-hover: #115e59;
            --teacher-light-btn: #e2e8f0;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            background: var(--teacher-bg);
            color: var(--teacher-text);
            font-family: "Segoe UI", sans-serif;
        }

        .teacher-shell {
            display: grid;
            grid-template-columns: 280px 1fr;
            min-height: 100vh;
        }

        .teacher-sidebar {
            background: linear-gradient(180deg, var(--teacher-sidebar), var(--teacher-sidebar-alt));
            color: white;
            padding: 1.75rem 1.15rem;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255,255,255,0.08);
        }

        .teacher-brand {
            font-size: 1.35rem;
            font-weight: 800;
            letter-spacing: 0.03em;
            margin-bottom: 2rem;
        }

        .teacher-brand span {
            display: block;
            margin-top: 0.35rem;
            font-size: 0.82rem;
            color: rgba(255,255,255,0.6);
            font-weight: 400;
        }

        .teacher-nav-title {
            font-size: 0.74rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: rgba(255,255,255,0.45);
            margin-bottom: 0.75rem;
            padding-left: 0.3rem;
        }

        .teacher-nav {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .teacher-nav a {
            display: block;
            text-decoration: none;
            color: rgba(255,255,255,0.92);
            padding: 0.9rem 1rem;
            border-radius: 14px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.06);
            font-weight: 600;
            transition: background 0.18s ease, transform 0.18s ease;
        }

        .teacher-nav a:hover {
            background: rgba(255,255,255,0.11);
            color: white;
            transform: translateX(2px);
        }

        .teacher-sidebar-footer {
            margin-top: auto;
            padding-top: 1.5rem;
            font-size: 0.88rem;
            color: rgba(255,255,255,0.6);
        }

        .teacher-main {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .teacher-topbar {
            background: rgba(255,255,255,0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--teacher-border);
            padding: 1.2rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .teacher-topbar-title h1 {
            margin: 0;
            font-size: 1.55rem;
            font-weight: 800;
        }

        .teacher-topbar-title p {
            margin: 0.3rem 0 0;
            color: var(--teacher-muted);
            font-size: 0.95rem;
        }

        .teacher-topbar-actions {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .teacher-topbar-actions a {
            text-decoration: none;
            border-radius: 12px;
            padding: 0.7rem 1rem;
            font-weight: 700;
            font-size: 0.92rem;
        }

        .teacher-btn-main {
            background: var(--teacher-accent);
            color: white;
        }

        .teacher-btn-main:hover {
            background: var(--teacher-accent-hover);
            color: white;
        }

        .teacher-btn-light {
            background: var(--teacher-light-btn);
            color: var(--teacher-text);
            border: 1px solid var(--teacher-border);
        }

        .teacher-btn-light:hover {
            background: #cbd5e1;
            color: var(--teacher-text);
        }

        .teacher-content {
            padding: 2rem;
        }

        .teacher-page-card {
            background: var(--teacher-surface);
            border: 1px solid var(--teacher-border);
            border-radius: 20px;
            box-shadow: 0 14px 35px rgba(15, 23, 42, 0.05);
            padding: 1.5rem;
        }

        @@media (max-width: 900px) {
            .teacher-shell {
                grid-template-columns: 1fr;
            }

            .teacher-sidebar {
                border-right: none;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }

            .teacher-topbar {
                padding: 1rem 1.25rem;
                flex-direction: column;
                align-items: flex-start;
            }

            .teacher-content {
                padding: 1.25rem;
            }
        }
    </style>
</head>
<body>
<div class="teacher-shell">
    <aside class="teacher-sidebar">
        <div class="teacher-brand">
            Teacher Panel
            <span>Teaching Workspace</span>
        </div>

        <div class="teacher-nav-title">Navigation</div>
        <nav class="teacher-nav">
            <a asp-area="Teacher" asp-controller="Home" asp-action="Index">Dashboard</a>
            <a asp-area="Teacher" asp-controller="Profile" asp-action="Index">Teacher Profile</a>
            <a asp-area="" asp-controller="Course" asp-action="Index">Courses</a>
            <a asp-area="" asp-controller="Lesson" asp-action="Index">Lessons</a>
            <a asp-area="" asp-controller="Home" asp-action="Index">Main Site</a>
        </nav>

        <div class="teacher-sidebar-footer">
            Dedicated workspace for teacher profile management and educational content.
        </div>
    </aside>

    <main class="teacher-main">
        <header class="teacher-topbar">
            <div class="teacher-topbar-title">
                <h1>@pageTitle</h1>
                <p>Manage your teacher profile, lessons, courses, and educational materials.</p>
            </div>

            <div class="teacher-topbar-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="teacher-btn-light">Main Site</a>
                <a asp-area="Teacher" asp-controller="Home" asp-action="Index" class="teacher-btn-main">Dashboard</a>
            </div>
        </header>

        <section class="teacher-content">
            <div class="teacher-page-card">
                @RenderBody()
            </div>
        </section>
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
