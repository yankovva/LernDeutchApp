@using LerningApp.Web.ViewModels.Lesson
@model LessonEditInputModel

@{
    ViewData["Title"] = "Edit Lesson";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">✏️ Edit Lesson</h1>
        <div class="text-muted">Change the content, name or the course of a lesson.</div>
    </div>

    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
        ← Back
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Name of the Lesson</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-8">
                            <label asp-for="CourseId" class="form-label">Course (optional)</label>
                            <select asp-for="CourseId" id="course-select" class="form-select">
                                <option value="">— No Course —</option>
                                @foreach (var c in Model.Courses)
                                {
                                    <option class="selected-course" value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CourseId" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Target" class="form-label">Цел на урока</label>
                        <textarea asp-for="Target" class="form-control" rows="3"
                                  placeholder="Exp: Describe your home."></textarea>
                        <span asp-validation-for="Target" class="text-danger"></span>
                    </div>
                    <div class="mb-3 mt-3">
                        <label asp-for="Content" class="form-label">Content</label>
                        <textarea asp-for="Content" class="form-control" rows="12"></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">💾 Save</button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}