@using LerningApp.Web.ViewModels.Teacher
@model IEnumerable<LessonTeacherIndexViewModel>

@{
    ViewData["Title"] = "Lessons";
}

<style>
    .teacher-lessons-page {
        display: grid;
        gap: 1.5rem;
    }

    .teacher-lessons-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }

    .teacher-lessons-header h2 {
        margin: 0;
        font-size: 1.55rem;
        font-weight: 800;
        color: #102542;
    }

    .teacher-lessons-header p {
        margin: 0.45rem 0 0;
        color: #64748b;
        line-height: 1.6;
    }

    .teacher-create-btn {
        display: inline-block;
        text-decoration: none;
        border-radius: 14px;
        padding: 0.8rem 1rem;
        font-weight: 700;
        background: #0f766e;
        color: white;
        white-space: nowrap;
    }

    .teacher-create-btn:hover {
        background: #115e59;
        color: white;
    }

    .teacher-lessons-table-wrap {
        overflow-x: auto;
    }

    .teacher-lessons-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
        background: white;
        border-radius: 18px;
        overflow: hidden;
    }

    .teacher-lessons-table thead th {
        text-align: left;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: #64748b;
        padding: 1rem 0.9rem;
        border-bottom: 1px solid #dbe3ec;
        background: #f8fafc;
    }

    .teacher-lessons-table tbody td {
        padding: 1rem 0.9rem;
        border-bottom: 1px solid #e5e7eb;
        vertical-align: middle;
        color: #102542;
    }

    .teacher-lessons-table tbody tr:hover {
        background: #f8fafc;
    }

    .teacher-lesson-name {
        font-weight: 700;
    }

    .teacher-lesson-badge {
        display: inline-block;
        padding: 0.42rem 0.75rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .teacher-lesson-badge-active {
        background: #dcfce7;
        color: #166534;
    }

    .teacher-lesson-badge-deleted {
        background: #fee2e2;
        color: #b91c1c;
    }

    .teacher-lesson-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
    }

    .teacher-lesson-actions a {
        border: none;
        border-radius: 10px;
        padding: 0.58rem 0.9rem;
        font-size: 0.88rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        background: #e2e8f0;
        color: #102542;
    }

    .teacher-lesson-actions a:hover {
        background: #cbd5e1;
        color: #102542;
    }

    .teacher-empty-state {
        padding: 2rem;
        text-align: center;
        color: #64748b;
        border: 1px dashed #cbd5e1;
        border-radius: 18px;
        background: #f8fafc;
    }

    @@media (max-width: 768px) {
        .teacher-lessons-header {
            flex-direction: column;
        }
    }
</style>

<div class="teacher-lessons-page">
    <div class="teacher-lessons-header">
        <div>
            <h2>Lesson Management</h2>
            <p>
                Review your lessons, see the course they belong to, and manage their content and exercises.
            </p>
        </div>

        <a asp-area="" asp-controller="Lesson" asp-action="Create" class="teacher-create-btn">
            Create New Lesson
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="teacher-empty-state">
            No lessons found yet. Start by creating your first lesson.
        </div>
    }
    else
    {
        <div class="teacher-lessons-table-wrap">
            <table class="teacher-lessons-table">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Course</th>
                    <th>Deleted</th>
                    <th>Exercises</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var lesson in Model)
                {
                    <tr>
                        <td class="teacher-lesson-name">@lesson.Name</td>
                        <td>@lesson.CourseName</td>
                        <td>
                            @if (lesson.IsDeleted)
                            {
                                <span class="teacher-lesson-badge teacher-lesson-badge-deleted">Deleted</span>
                            }
                            else
                            {
                                <span class="teacher-lesson-badge teacher-lesson-badge-active">Active</span>
                            }
                        </td>
                        <td>@lesson.ExercisesCount</td>
                        <td>
                            <div class="teacher-lesson-actions">
                                <a asp-area="Teacher"
                                   asp-controller="Lesson"
                                   asp-action="Manage"
                                   asp-route-id="@lesson.Id">
                                    Manage
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
