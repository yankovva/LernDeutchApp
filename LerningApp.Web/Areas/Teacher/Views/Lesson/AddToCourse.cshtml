@using LerningApp.Web.ViewModels.Lesson
@model AddLessonToCourseViewModel

@{
    ViewData["Title"] = "Assign lesson to course";
}

<style>
    .course-list {
        max-height: 420px;
        overflow: auto;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        padding: 10px;
        background: #fff;
    }

    .course-row {
        border-radius: 10px;
        padding: 10px 12px;
        transition: background-color .15s ease-in-out;
    }

    .course-row:hover { background-color: #f8f9fa; }

    .course-name { font-weight: 600; }

    .muted-id {
        font-size: .75rem;
        color: #adb5bd;
        word-break: break-all;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">🎯 Избор на курс за урок</h1>
        <div class="text-muted">Урокът може да бъде добавен към един курс.</div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">← Назад</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">

        <div class="mb-3">
            <span class="badge bg-secondary">Lesson</span>
            <h4 class="mt-2">@Model.LessonName</h4>
            <div class="muted-id">LessonId: @Model.LessonId</div>
        </div>

        <hr class="my-4" />

        <form asp-action="AddToCourse" asp-controller="Lesson" asp-area="Teacher" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="LessonId" />
            <input type="hidden" asp-for="LessonName" />

            <div class="mb-3">
                <input id="courseSearch"
                       type="text"
                       class="form-control"
                       placeholder="Търси курс по име..." />
            </div>
            <div class="mb-3">
                <label asp-for="OrderIndex" class="form-label">Ред на урока в курса</label>
                    <select asp-for="OrderIndex" class="form-select" id="order-index">
                    </select>
                    <span asp-validation-for="OrderIndex" class="text-danger"></span>
            </div>

            <div class="course-list" id="courseList">
                @for (int i = 0; i < Model.Courses.Count; i++)
                {
                    var c = Model.Courses[i];

                    <div class="course-row d-flex justify-content-between align-items-center"
                         data-name="@(c.CourseName.ToLowerInvariant())">

                        <div class="d-flex flex-column">
                            <label class="form-check-label course-name" for="course_@i">
                                @c.CourseName
                            </label>
                        </div>

                        <div class="form-check m-0">
                            <input class="form-check-input"
                                   type="radio"
                                   id="course_@i"
                                   name="SelectedCourseId"
                                   value="@c.CourseId"
                                   checked="@(Model.SelectedCourseId == c.CourseId)" />
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">💾 Запази</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Отказ</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const courseRadios = document.querySelectorAll('input[name="SelectedCourseId"]');
        const orderSelect = document.getElementById('order-index');

        if (!courseRadios.length || !orderSelect) return;

        async function loadIndexes(courseId) {
            orderSelect.innerHTML = '';
            if (!courseId) return;

            const res = await fetch(`https://localhost:7092/api/lessons/available-indexes?courseId=${encodeURIComponent(courseId)}`, {
                credentials: 'include'
            });
            if (!res.ok) {
                toastr.error('Invalid operation.');
                console.log('Failed to load indexes');
                return;
            }

            const indexes = await res.json();
            indexes.forEach(i => {
                const opt = document.createElement('option');
                opt.value = i;
                opt.textContent = i;
                orderSelect.appendChild(opt);
            });
        }

        courseRadios.forEach(radio => {
            radio.addEventListener('change', () => {
                if (radio.checked) {
                    loadIndexes(radio.value);
                }
            });
        });

        const selected = document.querySelector('input[name="SelectedCourseId"]:checked');
        if (selected) {
            loadIndexes(selected.value);
        }
    });
</script>

