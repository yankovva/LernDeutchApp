@using LerningApp.Web.ViewModels.Lesson
@model AddLessonInputModel

@{
    ViewData["Title"] = "Create Lesson";
}

<style>
    .hint { font-size: .9rem; color: #6c757d; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-1">➕ Create Lesson</h1>
        <div class="text-muted">Create lesson and if you want add it to a course.</div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">← Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Име на урока</label>
                        <input asp-for="Name" class="form-control" placeholder="Пример: Present Simple – introduction" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CourseId" class="form-label">Course (optional)</label>
                        <select asp-for="CourseId" class="form-select">
                            <option value="">— No Course —</option>
                            @foreach (var c in Model.Courses)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                        <div class="hint mt-1">You can leave the Lesson without a Course and add it later.</div>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Target" class="form-label">Цел на урока</label>
                        <textarea asp-for="Target" class="form-control" rows="1"
                                  placeholder="Exp: Describe your home."></textarea>
                        <span asp-validation-for="Target" class="text-danger"></span>
                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="Content" class="form-label">Съдържание</label>
                        <textarea asp-for="Content" class="form-control" rows="12"
                                  placeholder="Write the content of the lesson..."></textarea>
                        <span asp-validation-for="Content" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">💾 Create</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
