@using LerningApp.Web.ViewModels.MultipleChoiceExercise
@using static LerningApp.Common.Enums;
@model CreateMultipleChoiceExerciseViewModel

@{
    ViewData["Title"] = "Create Multiple Choice Exercise";
    var difficultyOptions = Enum.GetValues<ExerciseDifficultyLevel>()
        .Select(x => new
        {
            Value = (int)x,
            Text = x.ToString()
        })
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted">Create multiple‑choice exercise.</div>
    <a asp-controller="Lesson"
       asp-action="Details"
       asp-route-id="@Model.LessonId"
       class="btn btn-outline-secondary">← Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="LessonId" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Question" class="form-label">Question</label>
                        <input asp-for="Question" class="form-control" placeholder="Exp: Was bedeutet das Haus?" />
                        <span asp-validation-for="Question" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DifficultyLevel" class="form-label"> Difficulty Level</label>
                        <select asp-for="DifficultyLevel" class="form-select">
                            @foreach( var option in difficultyOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                        <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                    </div>

                    @for (var j = 0; j < 4; j++)
                    {
                        <div class="row mb-2 align-items-center">
                            <div class="col-md-8">
                                <input name="Options[@j].AnswerText" class="form-control" placeholder="Option @(j + 1)" />
                                <input type="hidden" name="Options[@j].OrderIndex" value="@(j + 1)" />
                                <input type="hidden"
                                       name="Options[@j].IsCorrect"
                                       value="false"
                                       class="is-correct-q-" />
                            </div>
                            <div class="col-md-4">
                                <input type="radio"
                                       name="correct"
                                       onchange="setCorrect(@j)" />
                                <label>Correct</label>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">💾 Create</button>
                        <a asp-controller="Lesson"
                           asp-action="Details"
                           asp-route-id="@Model.LessonId"
                           class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setCorrect(optionIndex) {
            const allHidden = document.querySelectorAll('.is-correct-q-');
            allHidden.forEach(x => x.value = 'false');

            const target = document.querySelector(
                `input[name="Options[${optionIndex}].IsCorrect"]`
            );
            if (target) target.value = 'true';
        }
    </script>
}