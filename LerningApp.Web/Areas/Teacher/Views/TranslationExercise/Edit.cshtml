@using LerningApp.Web.ViewModels.TranslationExercise
@using static LerningApp.Common.Enums
@model EditTranslationExerciseViewModel

@{
    ViewData["Title"] = "Edit Translation Exercise";
    var difficultyOptions = Enum.GetValues<ExerciseDifficultyLevel>()
        .Select(x => new
        {
            Value = (int)x,
            Text = x.ToString()
        })
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted">Редактирай translation упражнение.</div>
    <a asp-area="Teacher"
       asp-controller="Lesson"
       asp-action="Manage"
       asp-route-id="@Model.LessonId"
       class="btn btn-outline-secondary">
        ← Назад
    </a>
</div>

<div class="d-flex justify-content-end mb-3">
    <form asp-action="SoftDelete" method="post" class="d-inline"
          onsubmit="return confirm('Сигурна ли си, че искаш да изтриеш това упражнение?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="lessonId" value="@Model.LessonId" />
        <button type="submit" class="btn btn-danger btn-sm">Изтрий</button>
    </form>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input asp-for="Id" type="hidden" />
                    <input asp-for="LessonId" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="SentenceBg" class="form-label">Изречение на български</label>
                        <input asp-for="SentenceBg"
                               class="form-control"
                               placeholder="Къщата е червена." />
                        <span asp-validation-for="SentenceBg" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SentenceEn" class="form-label">Изречение на английски</label>
                        <input asp-for="SentenceEn"
                               class="form-control"
                               placeholder="The house is red." />
                        <span asp-validation-for="SentenceEn" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GermanCorrectTranslation" class="form-label">Правилен превод на немски</label>
                        <input asp-for="GermanCorrectTranslation"
                               class="form-control"
                               placeholder="Das Haus ist rot." />
                        <span asp-validation-for="GermanCorrectTranslation" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DifficultyLevel" class="form-label">Трудност</label>
                        <select asp-for="DifficultyLevel" class="form-select">
                            @foreach (var option in difficultyOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                        <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">💾 Запази</button>
                        <a asp-area="Teacher"
                           asp-controller="Lesson"
                           asp-action="Manage"
                           asp-route-id="@Model.LessonId"
                           class="btn btn-outline-secondary">
                            Отказ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
