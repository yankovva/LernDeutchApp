@using LerningApp.Web.ViewModels.TranslationExercise
@using static LerningApp.Common.Enums;
@model CreateTranslationExerciseViewModel

@{
    ViewData["Title"] = "Create Translation Exercise";
    var difficultyOptions = Enum.GetValues<ExerciseDifficultyLevel>()
        .Select(x => new
        {
            Value = (int)x,
            Text = x.ToString()
        })
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted">Edit translation exercise.</div>
    <a asp-controller="Lesson"
       asp-action="Details"
       asp-route-id="@Model.LessonId"
       class="btn btn-outline-secondary">← Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="LessonId" type="hidden" />
                    
                    <div class="mb-3">
                        <label asp-for="SentenceBg" class="form-label"> Bulgarish sentence .</label>
                        <input asp-for="SentenceBg" class="form-control" placeholder="Къщата е червена." />
                        <span asp-validation-for="SentenceBg" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="SentenceEn" class="form-label">English sentence</label>
                        <input asp-for="SentenceEn" class="form-control" placeholder="The house is red." />
                        <span asp-validation-for="SentenceEn" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="GermanCorrectTranslation" class="form-label">Correct german translation.</label>
                        <input asp-for="GermanCorrectTranslation" class="form-control" placeholder="Das Haus ist rot." />
                        <span asp-validation-for="GermanCorrectTranslation" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="DifficultyLevel" class="form-label">Трудност</label>
                        <select asp-for="DifficultyLevel" class="form-select">
                            @foreach( var option in difficultyOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                        <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                    </div>
                    
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">💾 Create</button>
                        <a asp-controller="Lesson"
                           asp-action="Details"
                           asp-route-id="@Model.LessonId"
                           class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
