@using LerningApp.Web.ViewModels.ListeningExercise
@using static LerningApp.Common.Enums
@model EditListeningExerciseViewModel

@{
    ViewData["Title"] = "Edit Listening Exercise";

    var difficultyOptions = Enum.GetValues<ExerciseDifficultyLevel>()
        .Select(x => new
        {
            Value = (int)x,
            Text = x.ToString()
        })
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Edit Listening Exercise</h2>
        <p class="text-muted mb-0">Update the exercise overview and manage each question separately.</p>
    </div>

    <a asp-area="Teacher"
       asp-controller="Lesson"
       asp-action="Manage"
       asp-route-id="@Model.LessonId"
       class="btn btn-outline-secondary">
        Back to Lesson
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h4 class="mb-3">Exercise Overview</h4>

                <form asp-area="Teacher"
                      asp-controller="ListeningExercise"
                      asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input asp-for="Id" type="hidden" />
                    <input asp-for="LessonId" type="hidden" />
                    <input asp-for="AudioPath" type="hidden" />

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Current Audio</label>

                        @if (!string.IsNullOrWhiteSpace(Model.AudioPath))
                        {
                            <div class="border rounded p-3 bg-light">
                                <audio controls class="w-100">
                                    <source src="@Url.Content(Model.AudioPath)" type="audio/mpeg" />
                                    Your browser does not support the audio element.
                                </audio>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                No audio file is currently uploaded.
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="AudioFile" class="form-label fw-semibold">Replace Audio File</label>
                        <input asp-for="AudioFile"
                               type="file"
                               class="form-control"
                               accept=".mp3,.wav,.ogg,.m4a" />
                        <span asp-validation-for="AudioFile" class="text-danger"></span>
                        <div class="form-text">Leave this empty if you want to keep the current audio file.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DifficultyLevel" class="form-label fw-semibold">Difficulty Level</label>
                        <select asp-for="DifficultyLevel" class="form-select">
                            @foreach (var option in difficultyOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                        <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Save Exercise
                        </button>
                    </div>
                </form>

                <hr class="my-4" />

                <form asp-area="Teacher"
                      asp-controller="ListeningExercise"
                      asp-action="SoftDelete"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this listening exercise?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="lessonId" value="@Model.LessonId" />
                    <button type="submit" class="btn btn-outline-danger">
                        Delete Exercise
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h4 class="mb-1">Questions</h4>
                        <p class="text-muted mb-0">Each question can be edited separately.</p>
                    </div>
                    
                    <button type="button"
                            class="btn btn-success"
                            data-bs-toggle="modal"
                            data-bs-target="#addQuestionModal">
                        Add Question
                    </button>
                    
                    <div class="modal fade" id="addQuestionModal" tabindex="-1" aria-labelledby="addQuestionModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-scrollable">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="addQuestionModalLabel">Add Listening Question</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>

                                <div class="modal-body">
                                    <form asp-area="Teacher"
                                          asp-controller="ListeningExercise"
                                          asp-action="CreateQuestion"
                                          method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="ExerciseId" value="@Model.Id" />

                                        <div class="mb-4">
                                            <label class="form-label fw-semibold" for="QuestionText">Question Text</label>
                                            <input id="QuestionText"
                                                   name="QuestionText"
                                                   class="form-control"
                                                   placeholder="Enter the question" />
                                        </div>

                                        <h6 class="mb-3">Answer Options</h6>

                                        <div class="row g-3">
                                            @for (int i = 0; i < 4; i++)
                                            {
                                                <div class="col-md-6">
                                                    <div class="border rounded p-3 bg-light h-100">
                                                        <label class="form-label">Option @(i + 1)</label>
                                                        <input name="Options[@i].AnswerText"
                                                               class="form-control mb-2"
                                                               placeholder="Enter answer option" />

                                                        <input type="hidden" name="Options[@i].OrderIndex" value="@i" />

                                                        <div class="form-check mt-2">
                                                            <input type="radio"
                                                                   class="form-check-input"
                                                                   name="CorrectOptionIndex"
                                                                   value="@i"
                                                                   @(i == 0 ? "checked" : null) />
                                                            <label class="form-check-label">Correct Answer</label>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <div class="d-flex justify-content-end gap-2 mt-4">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                                Cancel
                                            </button>
                                            <button type="submit" class="btn btn-primary">
                                                Save Question
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.Questions == null || !Model.Questions.Any())
                {
                    <div class="alert alert-info mb-0">
                        No questions have been added yet.
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            var question = Model.Questions[i];

                            <div class="border rounded p-3 bg-light-subtle question-card" id="question-card-@question.Id">
                                <div class="question-preview">
                                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                        <div>
                                            <div class="text-muted small mb-1">Question @(i + 1)</div>
                                            <h5 class="mb-0">@question.QuestionText</h5>
                                        </div>

                                        <div class="d-flex align-items-start gap-2">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary load-question-editor"
                                                    data-question-id="@question.Id"
                                                    data-target-id="question-editor-@question.Id"
                                                    data-card-id="question-card-@question.Id">
                                                Edit
                                            </button>

                                            <form asp-area="Teacher"
                                                  asp-controller="ListeningExercise"
                                                  asp-action="DeleteQuestion"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this question?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@question.Id" />
                                                <input type="hidden" name="exerciseId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                    @if (question.Options == null || !question.Options.Any())
                                    {
                                        <div class="text-muted">No answer options are available for this question.</div>
                                    }
                                    else
                                    {
                                        <ul class="list-group">
                                            @for (int j = 0; j < question.Options.Count; j++)
                                            {
                                                var option = question.Options[j];

                                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                                    <span>@option.AnswerText</span>

                                                    @if (option.IsCorrect)
                                                    {
                                                        <span class="badge bg-success">Correct Answer</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">Option</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                </div>

                                <div id="question-editor-@question.Id" class="question-editor-container"></div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .question-card-editing .question-preview {
            display: none;
        }

        .question-editor-container {
            margin-top: 1rem;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.load-question-editor').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const questionId = this.dataset.questionId;
                    const targetId = this.dataset.targetId;
                    const cardId = this.dataset.cardId;
                    const container = document.getElementById(targetId);
                    const card = document.getElementById(cardId);

                    if (!questionId || !container || !card) {
                        console.error('Missing questionId, target container, or card.', { questionId, targetId, cardId });
                        return;
                    }

                    try {
                        document.querySelectorAll('.question-editor-container').forEach(editor => editor.innerHTML = '');
                        document.querySelectorAll('.question-card').forEach(questionCard => questionCard.classList.remove('question-card-editing'));

                        const response = await fetch(`/Teacher/ListeningExercise/EditQuestion?id=${questionId}`, {
                            method: 'GET',
                            credentials: 'include'
                        });

                        if (!response.ok) {
                            container.innerHTML = `<div class="alert alert-danger">Could not load the question editor.</div>`;
                            return;
                        }

                        const html = await response.text();
                        container.innerHTML = html;
                        card.classList.add('question-card-editing');
                        container.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    } catch (error) {
                        console.error(error);
                        container.innerHTML = `<div class="alert alert-danger">Unexpected error while loading the editor.</div>`;
                    }
                });
            });
        });

        document.addEventListener('click', async function (event) {
            const btn = event.target.closest('.delete-option-btn');
            if (!btn) return;

            const optionId = btn.dataset.optionId;
            const questionId = btn.dataset.questionId;
            const token = document.querySelector('#editListeningQuestionForm input[name="__RequestVerificationToken"]')?.value;

            if (!optionId || !questionId || !token) return;

            const payload = {
                id: optionId,
                questionId: questionId
            };

            const response = await fetch('/Teacher/ListeningExercise/DeleteOption', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                credentials: 'include',
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                console.log('Could not delete option');
                return;
            }

            const data = await response.text();
            document.querySelector('#editListeningQuestionForm').outerHTML = data;
        });
        
        document.addEventListener('click', function (event) {
            const cancelBtn = event.target.closest('.cancel-question-editor-btn');
            if (!cancelBtn) return;

            const form = cancelBtn.closest('#editListeningQuestionForm');
            if (!form) return;

            const container = form.parentElement;
            const card = form.closest('.question-card');
            if (container) {
                container.innerHTML = '';
            }
            if (card) {
                card.classList.remove('question-card-editing');
            }
        });

        document.addEventListener('click', function (event) {
            const addBtn = event.target.closest('.add-option-btn');
            if (!addBtn) return;

            const form = addBtn.closest('#editListeningQuestionForm');
            if (!form) return;

            const container = form.querySelector('.question-options-container');
            if (!container) return;

            const newIndex = container.querySelectorAll('.option-item').length;

            const optionHtml = `
        <div class="col-md-6 option-item">
            <div class="border rounded p-3 bg-light h-100 d-flex flex-column">
                <label class="form-label fw-semibold">Option ${newIndex + 1}</label>

                <input name="Options[${newIndex}].AnswerText"
                       class="form-control mb-2"
                       placeholder="Enter answer option" />

                <input name="Options[${newIndex}].Id" type="hidden" value="" />
                <input name="Options[${newIndex}].OrderIndex" type="hidden" value="${newIndex}" />

                <div class="form-check mt-2">
                    <input type="radio"
                           class="form-check-input"
                           name="CorrectOptionIndex"
                           value="${newIndex}" />
                    <label class="form-check-label">Correct Answer</label>
                </div>
            </div>
        </div>
    `;

            container.insertAdjacentHTML('beforeend', optionHtml);
        });
    </script>

}
