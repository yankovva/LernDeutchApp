@using LerningApp.Web.ViewModels.ListeningExercise
@using static LerningApp.Common.Enums
@model EditListeningExerciseViewModel

@{
    ViewData["Title"] = "Edit Listening Exercise";
    var difficultyOptions = Enum.GetValues<ExerciseDifficultyLevel>()
        .Select(x => new
        {
            Value = (int)x,
            Text = x.ToString()
        })
        .ToList();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted">Редактирай listening упражнение.</div>
    <a asp-area="Teacher"
       asp-controller="Lesson"
       asp-action="Manage"
       asp-route-id="@Model.LessonId"
       class="btn btn-outline-secondary">
        ← Назад
    </a>
</div>

<div class="d-flex justify-content-end mb-3">
    <form asp-action="SoftDelete"
          method="post"
          class="d-inline"
          onsubmit="return confirm('Сигурна ли си, че искаш да изтриеш това упражнение?');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="lessonId" value="@Model.LessonId" />
        <button type="submit" class="btn btn-danger btn-sm">Изтрий</button>
    </form>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <input asp-for="Id" type="hidden" />
                    <input asp-for="LessonId" type="hidden" />
                    <input asp-for="AudioPath" type="hidden" />

                    <div class="mb-4">
                        <label asp-for="DifficultyLevel" class="form-label">Трудност</label>
                        <select asp-for="DifficultyLevel" class="form-select">
                            @foreach (var option in difficultyOptions)
                            {
                                <option value="@option.Value">@option.Text</option>
                            }
                        </select>
                        <span asp-validation-for="DifficultyLevel" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Текущо аудио</label>
                        @if (!string.IsNullOrWhiteSpace(Model.AudioPath))
                        {
                            <div class="border rounded p-3 bg-light">
                                <audio controls class="w-100">
                                    <source src="@Url.Content(Model.AudioPath)" type="audio/mpeg" />
                                    Your browser does not support the audio element.
                                </audio>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">Няма качено аудио.</div>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="AudioFile" class="form-label">Смени аудио файл</label>
                        <input asp-for="AudioFile" type="file" class="form-control" accept=".mp3,.wav,.ogg,.m4a" />
                        <span asp-validation-for="AudioFile" class="text-danger"></span>
                        <div class="form-text">Остави празно, ако искаш да запазиш текущото аудио.</div>
                    </div>

                    <hr class="my-4" />

                    <h5 class="mb-3">Въпроси</h5>

                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        <div class="card border-0 bg-light mb-4">
                            <div class="card-body">
                                <div class="mb-3">
                                    <label asp-for="Questions[i].QuestionText" class="form-label">
                                        Въпрос @(i + 1)
                                    </label>
                                    <input asp-for="Questions[i].QuestionText"
                                           class="form-control"
                                           placeholder="Въведи въпрос" />
                                    <span asp-validation-for="Questions[i].QuestionText" class="text-danger"></span>
                                </div>

                                <div class="row g-3">
                                    @for (int j = 0; j < Model.Questions[i].Options.Count; j++)
                                    {
                                        <div class="col-md-6">
                                            <div class="border rounded p-3 bg-white h-100">
                                                <label asp-for="Questions[i].Options[j].AnswerText" class="form-label">
                                                    Опция @(j + 1)
                                                </label>

                                                <input asp-for="Questions[i].Options[j].AnswerText"
                                                       class="form-control mb-2"
                                                       placeholder="Въведи отговор" />
                                                <span asp-validation-for="Questions[i].Options[j].AnswerText" class="text-danger"></span>

                                                <input asp-for="Questions[i].Options[j].OrderIndex" type="hidden" />
                                                <input asp-for="Questions[i].Options[j].IsCorrect" type="hidden" class="is-correct-hidden-@i" />

                                                <div class="form-check mt-2">
                                                    <input type="radio"
                                                           class="form-check-input"
                                                           name="correctOption_@i"
                                                           value="@j"
                                                           @(Model.Questions[i].Options[j].IsCorrect ? "checked" : null)
                                                           onchange="setCorrectOption(@i, @j)" />
                                                    <label class="form-check-label">Correct answer</label>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">💾 Запази</button>
                        <a asp-area="Teacher"
                           asp-controller="Lesson"
                           asp-action="Manage"
                           asp-route-id="@Model.LessonId"
                           class="btn btn-outline-secondary">
                            Отказ
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function setCorrectOption(questionIndex, optionIndex) {
            const hiddenInputs = document.querySelectorAll(`.is-correct-hidden-${questionIndex}`);
            hiddenInputs.forEach(x => x.value = 'false');

            const target = document.querySelector(`input[name="Questions[${questionIndex}].Options[${optionIndex}].IsCorrect"]`);
            if (target) {
                target.value = 'true';
            }
        }
    </script>
}
