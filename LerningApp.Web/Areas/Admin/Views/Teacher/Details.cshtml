@using Microsoft.AspNetCore.Mvc.TagHelpers
@using LerningApp.Web.ViewModels.Admin.Teacher
@model AdminTeacherDetailsViewModel

@{
    ViewData["Title"] = "Teacher Details";
}

<style>
    .teacher-details-page {
        display: grid;
        gap: 1.5rem;
    }

    .teacher-details-hero {
        position: relative;
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 1.75rem;
        padding: 2rem;
        border-radius: 26px;
        background:
            radial-gradient(circle at top left, rgba(29, 78, 216, 0.12), transparent 28%),
            linear-gradient(135deg, #f8fbff 0%, #ffffff 52%, #f2f7fb 100%);
        border: 1px solid #d9e3ef;
        box-shadow: 0 18px 40px rgba(15, 23, 42, 0.06);
    }

    .teacher-details-actions {
        position: absolute;
        top: 1.25rem;
        right: 1.25rem;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .teacher-details-actions form {
        margin: 0;
    }

    .teacher-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 12px;
        padding: 0.72rem 1rem;
        font-size: 0.92rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }

    .teacher-btn-approve {
        background: #166534;
        color: white;
    }

    .teacher-btn-approve:hover {
        background: #14532d;
        color: white;
    }

    .teacher-btn-reject {
        background: #fee2e2;
        color: #b91c1c;
    }

    .teacher-btn-reject:hover {
        background: #fecaca;
    }

    .teacher-avatar-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .teacher-avatar {
        width: 190px;
        height: 190px;
        border-radius: 999px;
        object-fit: cover;
        border: 6px solid #ffffff;
        box-shadow: 0 18px 34px rgba(15, 23, 42, 0.14);
        background: #e5e7eb;
    }

    .teacher-main {
        display: grid;
        gap: 1.2rem;
        align-content: center;
    }

    .teacher-heading h1 {
        margin: 0;
        font-size: 2.1rem;
        font-weight: 800;
        color: #102542;
        line-height: 1.08;
    }

    .teacher-subtitle {
        margin-top: 0.45rem;
        color: #64748b;
        font-size: 1rem;
        font-weight: 600;
    }

    .teacher-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        margin-top: 0.9rem;
    }

    .teacher-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .teacher-badge-status {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .teacher-badge-since {
        background: #dcfce7;
        color: #166534;
    }

    .teacher-section {
        background: #ffffff;
        border: 1px solid #d9e3ef;
        border-radius: 22px;
        padding: 1.5rem;
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.04);
    }

    .teacher-section h2 {
        margin: 0 0 1rem;
        font-size: 1.2rem;
        font-weight: 800;
        color: #102542;
    }

    .teacher-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem 2rem;
    }

    .teacher-info-item {
        display: grid;
        gap: 0.2rem;
    }

    .teacher-label {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
        color: #94a3b8;
    }

    .teacher-value {
        font-size: 1rem;
        color: #0f172a;
        font-weight: 700;
        word-break: break-word;
    }

    .teacher-text-block {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 1.1rem 1.15rem;
        color: #334155;
        line-height: 1.7;
        white-space: pre-line;
        min-height: 120px;
    }

    .teacher-empty {
        color: #94a3b8;
        font-style: italic;
    }

    .teacher-review-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .teacher-review-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 1.25rem;
    }

    .teacher-review-card h3 {
        margin: 0 0 1rem;
        font-size: 1rem;
        font-weight: 800;
        color: #102542;
    }

    .teacher-review-images {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 1rem;
    }

    .teacher-review-image-box {
        display: grid;
        gap: 0.5rem;
    }

    .teacher-review-image-box img {
        width: 100%;
        max-width: 220px;
        aspect-ratio: 1 / 1;
        object-fit: cover;
        border-radius: 18px;
        border: 1px solid #d9e3ef;
        background: #e5e7eb;
    }
    .teacher-review-changed {
        background: #dcfce7;
        border: 1px solid #86efac;
        border-radius: 12px;
        padding: 0.55rem 0.7rem;
    }

    .teacher-text-block-changed {
        background: #dcfce7;
        border: 1px solid #86efac;
    }
    .teacher-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
    }

    .teacher-stat-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 1.1rem;
    }

    .teacher-stat-number {
        font-size: 1.8rem;
        font-weight: 800;
        color: #102542;
    }

    .teacher-stat-label {
        margin-top: 0.35rem;
        color: #64748b;
        font-weight: 600;
    }

    @@media (max-width: 960px) {
        .teacher-stats-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 640px) {
        .teacher-stats-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 960px) {
        .teacher-details-hero,
        .teacher-review-grid,
        .teacher-info-grid,
        .teacher-review-images {
            grid-template-columns: 1fr;
        }

        .teacher-details-actions {
            position: static;
            margin-bottom: 1rem;
        }
    }
    
</style>

<div class="teacher-details-page">
    <section class="teacher-details-hero">
        @if (Model.HasPendingChanges)
        {
            <div class="teacher-details-actions">
                <form asp-area="Admin"
                      asp-controller="Teacher"
                      asp-action="Approve"
                      asp-route-id="@Model.UserId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="teacher-btn teacher-btn-approve">
                        Approve
                    </button>
                </form>

                <form asp-area="Admin"
                      asp-controller="Teacher"
                      asp-action="Reject"
                      asp-route-id="@Model.UserId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="teacher-btn teacher-btn-reject">
                        Reject
                    </button>
                </form>
            </div>
        }

        <div class="teacher-avatar-wrap">
            <img class="teacher-avatar"
                 src="@(string.IsNullOrWhiteSpace(Model.ProfileImage) ? "/images/Common/default-profile-picture.jpg" : Model.ProfileImage)"
                 alt="Teacher profile image" />
        </div>

        <div class="teacher-main">
            <div class="teacher-heading">
                <h1>@($"{Model.FirstName ?? "Unknown"} {Model.LastName ?? "Teacher"}")</h1>
                <div class="teacher-subtitle">@(Model.Email ?? "No email added")</div>

                <div class="teacher-badges">
                    <span class="teacher-badge teacher-badge-status">@Model.Status</span>
                    <span class="teacher-badge teacher-badge-since">
                        Teacher Since: @(Model.TeacherSince ?? "Pending")
                    </span>
                </div>
            </div>
        </div>
    </section>

    @if (Model.HasPendingChanges)
    {
        <section class="teacher-section">
            <h2>Pending Review Changes</h2>

            <div class="teacher-review-grid">
                <div class="teacher-review-card">
                    <h3>Current</h3>

                    <div class="teacher-info-grid">
                        <div class="teacher-info-item">
                            <div class="teacher-label">First Name</div>
                            <div class="teacher-value">@(Model.FirstName ?? "Not set")</div>
                        </div>

                        <div class="teacher-info-item">
                            <div class="teacher-label">Last Name</div>
                            <div class="teacher-value">@(Model.LastName ?? "Not set")</div>
                        </div>

                        <div class="teacher-info-item">
                            <div class="teacher-label">Phone Number</div>
                            <div class="teacher-value">@(Model.PhoneNumber ?? "Not set")</div>
                        </div>
                    </div>

                    <div class="teacher-review-images">
                        <div class="teacher-review-image-box">
                            <div class="teacher-label">Current Image</div>
                            <img src="@(string.IsNullOrWhiteSpace(Model.ProfileImage) ? "/images/Common/default-profile-picture.jpg" : Model.ProfileImage)"
                                 alt="Current teacher image" />
                        </div>
                    </div>

                    <div style="margin-top: 1rem;">
                        <div class="teacher-label">Biography</div>
                        <div class="teacher-text-block">
                            @if (string.IsNullOrWhiteSpace(Model.Biography))
                            {
                                <span class="teacher-empty">No biography has been added yet.</span>
                            }
                            else
                            {
                                @Model.Biography
                            }
                        </div>
                    </div>

                    <div style="margin-top: 1rem;">
                        <div class="teacher-label">Qualifications</div>
                        <div class="teacher-text-block">
                            @if (string.IsNullOrWhiteSpace(Model.Qualifications))
                            {
                                <span class="teacher-empty">No qualifications have been added yet.</span>
                            }
                            else
                            {
                                @Model.Qualifications
                            }
                        </div>
                    </div>
                </div>

                <div class="teacher-review-card">
                    <h3>Pending</h3>

                    <div class="teacher-info-grid">
                        <div class="teacher-info-item">
                            <div class="teacher-label">First Name</div>
                            <div class="teacher-value @(Model.PendingFirstName != null && Model.PendingFirstName != Model.FirstName ? "teacher-review-changed" : "")">
                                @(Model.PendingFirstName ?? "No change submitted")
                            </div>
                        </div>

                        <div class="teacher-info-item">
                            <div class="teacher-label">Last Name</div>
                            <div class="teacher-value @(Model.PendingLastName != null && Model.PendingLastName != Model.LastName ? "teacher-review-changed" : "")">
                                @(Model.PendingLastName ?? "No change submitted")
                            </div>
                        </div>

                        <div class="teacher-info-item">
                            <div class="teacher-label">Phone Number</div>
                            <div class="teacher-value @(Model.PendingPhoneNumber != null && Model.PendingPhoneNumber != Model.PhoneNumber ? "teacher-review-changed" : "")">
                                @(Model.PendingPhoneNumber ?? "No change submitted")
                            </div>
                        </div>
                    </div>

                    <div class="teacher-review-images">
                        <div class="teacher-review-image-box @(Model.PendingProfileImage != null && Model.PendingProfileImage != Model.ProfileImage ? "teacher-review-changed" : "")">
                            <div class="teacher-label">Pending Image</div>
                            <img src="@(string.IsNullOrWhiteSpace(Model.PendingProfileImage) ? "/images/Common/default-profile-picture.jpg" : Model.PendingProfileImage)"
                                 alt="Pending teacher image" />
                        </div>
                    </div>

                    <div style="margin-top: 1rem;">
                        <div class="teacher-label">Biography</div>
                        <div class="teacher-text-block @(Model.PendingBiography != null && Model.PendingBiography != Model.Biography ? "teacher-text-block-changed" : "")">

                        @if (string.IsNullOrWhiteSpace(Model.PendingBiography))
                            {
                                <span class="teacher-empty">No change submitted.</span>
                            }
                            else
                            {
                                @Model.PendingBiography
                            }
                        </div>
                    </div>

                    <div style="margin-top: 1rem;">
                        <div class="teacher-label">Qualifications</div>
                        <div class="teacher-text-block @(Model.PendingQualifications != null && Model.PendingQualifications != Model.Qualifications ? "teacher-text-block-changed" : "")">
                        @if (string.IsNullOrWhiteSpace(Model.PendingQualifications))
                            {
                                <span class="teacher-empty">No change submitted.</span>
                            }
                            else
                            {
                                @Model.PendingQualifications
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="teacher-section">
            <h2>Current Information</h2>

            <div class="teacher-info-grid">
                <div class="teacher-info-item">
                    <div class="teacher-label">First Name</div>
                    <div class="teacher-value">@(Model.FirstName ?? "Not set")</div>
                </div>

                <div class="teacher-info-item">
                    <div class="teacher-label">Last Name</div>
                    <div class="teacher-value">@(Model.LastName ?? "Not set")</div>
                </div>

                <div class="teacher-info-item">
                    <div class="teacher-label">Username</div>
                    <div class="teacher-value">@(Model.UserName ?? "Not set")</div>
                </div>

                <div class="teacher-info-item">
                    <div class="teacher-label">Email</div>
                    <div class="teacher-value">@(Model.Email ?? "Not set")</div>
                </div>

                <div class="teacher-info-item">
                    <div class="teacher-label">Phone Number</div>
                    <div class="teacher-value">@(Model.PhoneNumber ?? "Not set")</div>
                </div>

                <div class="teacher-info-item">
                    <div class="teacher-label">Status</div>
                    <div class="teacher-value">@Model.Status</div>
                </div>
            </div>
        </section>

        <section class="teacher-section">
            <h2>Current Biography</h2>
            <div class="teacher-text-block">
                @if (string.IsNullOrWhiteSpace(Model.Biography))
                {
                    <span class="teacher-empty">No biography has been added yet.</span>
                }
                else
                {
                    @Model.Biography
                }
            </div>
        </section>

        <section class="teacher-section">
            <h2>Current Qualifications</h2>
            <div class="teacher-text-block">
                @if (string.IsNullOrWhiteSpace(Model.Qualifications))
                {
                    <span class="teacher-empty">No qualifications have been added yet.</span>
                }
                else
                {
                    @Model.Qualifications
                }
            </div>
        </section>
        <section class="teacher-section">
            <h2>Content Overview</h2>

            <div class="teacher-stats-grid">
                <div class="teacher-stat-card">
                    <div class="teacher-stat-number">@Model.CreatedCoursesCount</div>
                    <div class="teacher-stat-label">Created Courses</div>
                </div>

                <div class="teacher-stat-card">
                    <div class="teacher-stat-number">@Model.CreatedLessonsCount</div>
                    <div class="teacher-stat-label">Created Lessons</div>
                </div>

                <div class="teacher-stat-card">
                    <div class="teacher-stat-number">@Model.CreatedVocabularyCardsCount</div>
                    <div class="teacher-stat-label">Vocabulary Cards</div>
                </div>

                <div class="teacher-stat-card">
                    <div class="teacher-stat-number">@Model.TotalCreatedExercisesCount</div>
                    <div class="teacher-stat-label">Total Exercises</div>
                </div>
            </div>
        </section>

    }
</div>
