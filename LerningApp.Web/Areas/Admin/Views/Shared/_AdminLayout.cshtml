@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Admin";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
          integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
    <style>
        :root {
            --admin-bg: #eef2f6;
            --admin-surface: #ffffff;
            --admin-sidebar: #0f172a;
            --admin-sidebar-alt: #111827;
            --admin-border: #d9e1ea;
            --admin-text: #0f172a;
            --admin-muted: #64748b;
            --admin-accent: #1d4ed8;
            --admin-accent-hover: #1e40af;
        }

        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            background: var(--admin-bg);
            color: var(--admin-text);
            font-family: "Segoe UI", sans-serif;
        }

        .admin-shell {
            display: grid;
            grid-template-columns: 96px 1fr;
            min-height: 100vh;
        }

        .admin-sidebar {
            background: linear-gradient(180deg, var(--admin-sidebar), var(--admin-sidebar-alt));
            color: white;
            padding: 1.4rem 0.9rem;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255,255,255,0.06);
        }

        .admin-logo {
            font-size: 1.6rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            margin-bottom: 1.8rem;
            text-align: center;
        }

        .admin-logo span {
            display: none;
        }

        .admin-nav-group-title {
            display: none;
        }

        .admin-nav {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            align-items: center;
        }

        .admin-nav a {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: rgba(255,255,255,0.9);
            width: 56px;
            height: 56px;
            border-radius: 18px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
            font-weight: 600;
            transition: background 0.18s ease, transform 0.18s ease, border-color 0.18s ease;
        }

        .admin-nav a:hover {
            background: rgba(255,255,255,0.09);
            color: white;
            transform: translateY(-1px);
            border-color: rgba(255,255,255,0.14);
        }

        .admin-nav-icon {
            font-size: 1.35rem;
            line-height: 1;
        }

        .admin-nav-label {
            position: absolute;
            left: calc(100% + 12px);
            top: 50%;
            transform: translateY(-50%);
            white-space: nowrap;
            padding: 0.55rem 0.8rem;
            border-radius: 12px;
            background: #ffffff;
            color: var(--admin-text);
            font-size: 0.85rem;
            font-weight: 700;
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.18);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.16s ease, transform 0.16s ease;
            z-index: 20;
        }

        .admin-nav a:hover .admin-nav-label {
            opacity: 1;
            transform: translateY(-50%) translateX(2px);
        }

        .admin-sidebar-footer {
            margin-top: auto;
            padding-top: 1rem;
            text-align: center;
            font-size: 1.25rem;
            color: rgba(255,255,255,0.55);
        }

        .admin-main {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .admin-topbar {
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--admin-border);
            padding: 1.2rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
        }

        .admin-topbar-title h1 {
            margin: 0;
            font-size: 1.55rem;
            font-weight: 700;
        }

        .admin-topbar-title p {
            margin: 0.3rem 0 0;
            color: var(--admin-muted);
            font-size: 0.95rem;
        }

        .admin-topbar-actions {
            display: flex;
            gap: 0.75rem;
            align-items: center;
        }

        .admin-topbar-actions a {
            text-decoration: none;
            border-radius: 12px;
            padding: 0.7rem 1rem;
            font-weight: 600;
            font-size: 0.92rem;
        }

        .admin-btn-main {
            background: var(--admin-accent);
            color: white;
        }

        .admin-btn-main:hover {
            background: var(--admin-accent-hover);
            color: white;
        }

        .admin-btn-light {
            background: white;
            color: var(--admin-text);
            border: 1px solid var(--admin-border);
        }

        .admin-btn-light:hover {
            background: #f8fafc;
            color: var(--admin-text);
        }

        .admin-content {
            padding: 2rem;
        }

        .admin-page-card {
            background: var(--admin-surface);
            border: 1px solid var(--admin-border);
            border-radius: 20px;
            box-shadow: 0 14px 35px rgba(15, 23, 42, 0.05);
            padding: 1.5rem;
        }

        @@media (max-width: 900px) {
            .admin-shell {
                grid-template-columns: 1fr;
            }

            .admin-sidebar {
                border-right: none;
                border-bottom: 1px solid rgba(255,255,255,0.06);
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                padding: 1rem;
            }

            .admin-nav {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-start;
            }

            .admin-topbar {
                padding: 1rem 1.25rem;
                flex-direction: column;
                align-items: flex-start;
            }

            .admin-content {
                padding: 1.25rem;
            }
        }
    </style>
</head>
<body>
<div class="admin-shell">
    <aside class="admin-sidebar">
        <div class="admin-logo">
            <i class="fa-solid fa-screwdriver-wrench"  style="color: rgb(237, 237, 237);"></i>
        </div>

        <nav class="admin-nav">
            <a asp-area="Admin" asp-controller="Home" asp-action="Index" title="Dashboard">
                <i class="fa-solid fa-house-user" style="color: rgb(237, 237, 237);"></i>
                <span class="admin-nav-label">Dashboard</span>
            </a>
            <a asp-area="Admin" asp-controller="Teacher" asp-action="Index" title="Teachers">
                <i class="fa-solid fa-chalkboard-user " style="color: rgb(237, 237, 237);"></i>
                <span class="admin-nav-label">Teachers</span>
            </a>
            <a asp-area="Admin" asp-controller="User" asp-action="Index" title="Users">
                <i class="fa-solid fa-users-gear" style="color: rgb(237, 237, 237);"></i>
                <span class="admin-nav-label">Users</span>
            </a>
            <a asp-area="Admin" asp-controller="Reports" asp-action="Index" title="Reports">
                <i class="fa-solid fa-bug"  style="color: rgb(237, 237, 237);"></i>
                <span class="admin-nav-label">Reports</span>
            </a>
        </nav>

        <div class="admin-sidebar-footer">
            ✦
        </div>
    </aside>

    <main class="admin-main">
        <header class="admin-topbar">
            <div class="admin-topbar-title">
                <h1>@pageTitle</h1>
                <p>Administrative workspace for users, teachers, reports, and content.</p>
            </div>

            <div class="admin-topbar-actions">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="admin-btn-light">Main Site</a>
                <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="admin-btn-main">Dashboard</a>
            </div>
        </header>

        <section class="admin-content">
            <div class="admin-page-card">
                @RenderBody()
            </div>
        </section>
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)
<partial name="~/Views/Shared/_NotificationsPartial.cshtml" />
</body>
</html>
