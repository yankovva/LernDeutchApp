@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-shell">
    <div class="auth-card auth-card--login">
        <div class="auth-visual">
            <div class="auth-brand">Lernia</div>
            <span class="auth-badge">Welcome back</span>

            <h1>Learn smarter, one lesson at a time.</h1>
            <p>
                Continue your language journey with interactive lessons, exercises,
                and progress that keeps moving with you.
            </p>

            <div class="auth-visual-stack">
                <div class="book-card book-card--main"></div>
                <div class="book-card book-card--accent"></div>
                <div class="book-card book-card--small"></div>
                <div class="auth-avatar auth-avatar--one"></div>
                <div class="auth-avatar auth-avatar--two"></div>
            </div>
        </div>

        <section class="auth-form-panel">
            <div class="auth-form-wrap">
                <p class="auth-eyebrow">Sign in</p>
                <h2>Login to your account</h2>
                <p class="auth-subtitle">Welcome back! Please enter your details.</p>

                <form id="account" method="post" class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>

                    <div class="auth-field">
                        <label asp-for="Input.Email">Email address</label>
                        <input asp-for="Input.Email"
                               class="auth-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="auth-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.Password">Password</label>
                        <input asp-for="Input.Password"
                               class="auth-input"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Enter your password" />
                        <span asp-validation-for="Input.Password" class="auth-error"></span>
                    </div>

                    <div class="auth-meta">
                        <label asp-for="Input.RememberMe" class="auth-check">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <span>@Html.DisplayNameFor(m => m.Input.RememberMe)</span>
                        </label>

                        <a id="forgot-password" asp-page="./ForgotPassword" class="auth-link">Forgot password?</a>
                    </div>

                    <button id="login-submit" type="submit" class="auth-button">
                        Log in
                    </button>

                    <p class="auth-switch">
                        Don’t have an account?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create one</a>
                    </p>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="auth-divider"><span>or continue with</span></div>

                        <form id="external-account"
                              asp-page="./ExternalLogin"
                              asp-route-returnUrl="@Model.ReturnUrl"
                              method="post"
                              class="auth-external">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit"
                                        class="auth-social-button"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Log in using your @provider.DisplayName account">
                                    @provider.DisplayName
                                </button>
                            }
                        </form>
                    }
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
