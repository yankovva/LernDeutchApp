@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="auth-shell">
    <div class="auth-card auth-card--register">
        <div class="auth-visual auth-visual--warm">
            <div class="auth-brand">Lernia</div>
            <span class="auth-badge">Join today</span>

            <h1>Create your learning space.</h1>
            <p>
                Build your account and start learning with clean lessons,
                guided practice, and a progress path designed for consistency.
            </p>

            <div class="auth-feature-list">
                <div class="auth-feature-item">
                    <span class="auth-feature-dot"></span>
                    <span>Track lesson progress</span>
                </div>
                <div class="auth-feature-item">
                    <span class="auth-feature-dot"></span>
                    <span>Practice vocabulary daily</span>
                </div>
                <div class="auth-feature-item">
                    <span class="auth-feature-dot"></span>
                    <span>Learn in your native language</span>
                </div>
            </div>
        </div>

        <section class="auth-form-panel">
            <div class="auth-form-wrap">
                <p class="auth-eyebrow">Get started</p>
                <h2>Create a new account</h2>
                <p class="auth-subtitle">Fill in the details below to register.</p>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="auth-validation" role="alert"></div>

                    <div class="auth-field">
                        <label asp-for="Input.Email">Email address</label>
                        <input asp-for="Input.Email"
                               class="auth-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="auth-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.Username">Username</label>
                        <input asp-for="Input.Username"
                               class="auth-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="Choose a username" />
                        <span asp-validation-for="Input.Username" class="auth-error"></span>
                    </div>

                    <div class="auth-grid">
                        <div class="auth-field">
                            <label asp-for="Input.Password">Password</label>
                            <input asp-for="Input.Password"
                                   class="auth-input"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Create password" />
                            <span asp-validation-for="Input.Password" class="auth-error"></span>
                        </div>

                        <div class="auth-field">
                            <label asp-for="Input.ConfirmPassword">Confirm password</label>
                            <input asp-for="Input.ConfirmPassword"
                                   class="auth-input"
                                   autocomplete="new-password"
                                   aria-required="true"
                                   placeholder="Repeat password" />
                            <span asp-validation-for="Input.ConfirmPassword" class="auth-error"></span>
                        </div>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Input.NativeLanguage">Native language</label>
                        <select asp-for="Input.NativeLanguage" class="auth-input auth-select">
                            <option value="Bg">Български</option>
                            <option value="En">English</option>
                        </select>
                        <span asp-validation-for="Input.NativeLanguage" class="auth-error"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="auth-button">
                        Create account
                    </button>

                    <p class="auth-switch">
                        Already have an account?
                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
                    </p>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="auth-divider"><span>or sign up with</span></div>

                        <form id="external-account"
                              asp-page="./ExternalLogin"
                              asp-route-returnUrl="@Model.ReturnUrl"
                              method="post"
                              class="auth-external">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit"
                                        class="auth-social-button"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Register using your @provider.DisplayName account">
                                    @provider.DisplayName
                                </button>
                            }
                        </form>
                    }
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
